.gomodcache/
.gocache/

.worktrees/

# Release artifacts & deployment state (发布产物 tar/SHA/manifest 不进版本库)
# release/ 由发布脚本本地生成：deeix-chat-<short>-linux-amd64.tar、deeix-sandbox-<short>-linux-amd64.tar、
# SHA256SUMS、manifest.env 仅随发布流程 scp 分发；*.tar 一律不提交，仓库不保留任何 release 豁免。
/release/
deployment-result.env

# 本地验证/发布操作产物（整类不进版本库）
/output/
.codex-runtime-*/
/.codex-candidate-config-*.yaml
/.playwright-cli/
/.agents/
/.mancode/
*.tar

# mancode continuity 自动生成的 bootstrap（团队共享内容请放 docs/）
/AGENTS.md

